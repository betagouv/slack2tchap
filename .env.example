# ==============================================================================
# slack2tchap - Configuration Option A (100% Stateless & Multi-tenant)
# ==============================================================================

# Port d'écoute pour le conteneur PostgreSQL local
POSTGRES_PORT=5436

# URL de connexion PostgreSQL (Scalingo Postgres ou local)
DATABASE_URL=postgresql+asyncpg://slack2tchap:postgres_dev_password@localhost:5436/slack2tchap_dev

# Clé maîtresse AES-256-GCM pour chiffrer les mots de passe des bots Matrix au repos (32 caractères min)
SECRET_ENCRYPTION_KEY=change_this_to_a_secure_32_bytes_master_key_!

# Administrateur initial (généré automatiquement par Alembic au démarrage si configuré)
ADMIN_EMAIL=admin@tchap.gouv.fr
# Générez une clé avec : uv run python scripts/generate_api_key.py
ADMIN_API_KEY=s2t_live_votre_cle_api_secrete_ici

# URL publique de la passerelle pour génération des liens de webhooks
PUBLIC_BASE_URL=http://localhost:8000

# URL du homeserver Matrix / Tchap interministériel
MATRIX_HOMESERVER=https://matrix.agent.tchap.gouv.fr

# Rejoindre automatiquement les salons sur invitation
MATRIX_AUTO_JOIN=true

# Configuration du serveur HTTP FastAPI
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
