{
  "include": [
    "slack2tchap-core/src",
    "slack2tchap-core/tests",
    "slack2tchap-stateless/src",
    "slack2tchap-stateless/tests",
    "slack2tchap/src",
    "slack2tchap/tests"
  ],
  "extraPaths": [
